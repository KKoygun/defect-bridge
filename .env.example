# ── Jira (optional) ───────────────────────────────────────────────────────────

# cloud (default) or datacenter
# JIRA_FLAVOR=cloud

# Jira instance URL (no trailing slash)
JIRA_BASE_URL=https://yourworkspace.atlassian.net

# Jira Cloud: account email + API token — generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your_api_token_here

# Jira Data Center: personal access token (Profile → Personal Access Tokens)
# JIRA_PAT=your_personal_access_token

# Optional status changes (off by default — only comments are posted).
# A transition name or the status it leads to, matched case-insensitively.
# Test fails on a ticket that is already done:
# JIRA_REOPEN_TRANSITION=Reopen
# Test passes on a ticket that is still open:
# JIRA_PASS_TRANSITION=Ready for QA


# ── GitHub Issues (optional — set both to enable GitHub reporting) ────────────

# Personal Access Token with repo > issues write scope
# Generate at: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Target repository in owner/repo format
# GITHUB_REPO=your-org/your-repo

# GitHub Enterprise Server API URL (set automatically inside GitHub Actions)
# GITHUB_API_URL=https://github.example.com/api/v3


# ── Shared settings ───────────────────────────────────────────────────────────

# Path to allure-results directory (default: allure-results)
# ALLURE_RESULTS_DIR=allure-results

# Environment label shown in comments (default: dev)
# ENV=staging

# CI run id shown in comments and used to skip duplicates on a re-run
# (auto-detected from GITHUB_RUN_NUMBER in GitHub Actions)
# CI_RUN_ID=local-run-1

# Exit 1 when a ticket could not be updated (default: false — only config errors fail the build)
# FAIL_ON_REPORT_ERROR=false
