# Jira Cloud instance URL (no trailing slash)
JIRA_BASE_URL=https://yourworkspace.atlassian.net

# Jira account email
JIRA_EMAIL=your@email.com

# Jira API token — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Path to allure-results directory (default: allure-results)
# ALLURE_RESULTS_DIR=allure-results

# Environment label shown in Jira comments (default: dev)
# ENV=staging

# Optional: override CI run ID shown in comments (auto-detected from GITHUB_RUN_NUMBER in CI)
# CI_RUN_ID=local-run-1
