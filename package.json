{
  "name": "defect-bridge",
  "version": "1.0.0",
  "description": "Posts Allure test failures as comments on the Jira (Cloud or Data Center) or GitHub issues they are tagged with",
  "scripts": {
    "report": "ts-node scripts/run.ts",
    "example": "ts-node scripts/run.ts --dry-run --results-dir=examples/allure-results",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.38.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.6",
    "zod": "^4.3.6"
  }
}
